{
  "schemaVersion": 1,
  "id": "standard-magenta",
  "name": "Standard Magenta",
  "description": "Starttemplate angelehnt an die vorhandene UBB-Werbekachel.",
  "width": 1138,
  "height": 1138,
  "fields": [
    {
      "id": "headline",
