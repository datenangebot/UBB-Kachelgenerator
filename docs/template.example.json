      "y": 820,
      "width": 360,
      "height": 60,
      "rotation": -90,
      "opacity": 1,
      "zIndex": 40,
      "fontFamily": "Arial, sans-serif",
      "fontWeight": 700,
      "minFontSize": 24,
      "maxFontSize": 40,
      "lineHeight": 1,
      "maxLines": 1,
      "wrap": false,
      "color": "#ffffff",
      "textAlign": "left",
      "verticalAlign": "middle",
      "letterSpacing": 0
    }
  ]
