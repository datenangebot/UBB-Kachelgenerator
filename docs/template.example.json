      "id": "photo",
      "name": "Hintergrundfoto",
      "type": "photo",
      "x": 380,
      "y": 0,
      "width": 758,
      "height": 1138,
      "rotation": 0,
      "opacity": 1,
      "zIndex": 10,
      "crop": { "positionX": 50, "positionY": 50, "zoom": 1 }
    },
    {
      "id": "magenta-panel",
      "name": "Magenta Fläche",
      "type": "shape",
      "x": 0,
      "y": 0,
      "width": 430,
      "height": 1138,
      "rotation": 0,
      "opacity": 1,
      "zIndex": 20,
      "fillColor": "#c0007f",
      "borderRadius": 0
    },
    {
      "id": "headline",
      "name": "Überschrift",
      "type": "text",
      "binding": { "type": "field", "fieldId": "headline" },
      "x": 70,
      "y": 90,
      "width": 770,
      "height": 180,
      "rotation": 0,
      "opacity": 1,
      "zIndex": 30,
      "fontFamily": "Arial, sans-serif",
      "fontWeight": 700,
      "minFontSize": 48,
      "maxFontSize": 82,
      "lineHeight": 1.05,
      "maxLines": 2,
      "wrap": true,
      "color": "#ffffff",
