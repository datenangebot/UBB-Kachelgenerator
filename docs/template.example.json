      "label": "Datum",
      "inputType": "text",
      "defaultValue": "Sa 29.08.",
      "order": 20
    },
    {
      "id": "time",
      "label": "Uhrzeit",
      "inputType": "text",
      "defaultValue": "18:00h",
      "order": 30
    },
    {
      "id": "mainText",
      "label": "Haupttext",
      "inputType": "text",
      "defaultValue": "Uni-BigBand Kiel",
